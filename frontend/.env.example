# Smart Employee Onboarding & Identity Service - Environment Variables
# Copy to .env.local or set during deployment

# Base URL of the deployed API Gateway (e.g., https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev)
VITE_API_BASE_URL=

# Amazon Cognito User Pool Configuration
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1
